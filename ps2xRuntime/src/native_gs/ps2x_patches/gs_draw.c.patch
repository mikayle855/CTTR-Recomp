+/* [ps2x] A replacement asked for when this texture was first seen: swapped in once ps2tex's workers have decoded it
+   (the original is shown until then, a few frames). */
+static void tex_pack_poll(Tex *c) {
+    TexPackImage pack;
+    int level, f;
+    GsTex nt;
+    if (TexPack_LoadAsync(c->pend, &pack) != 1) {
+        if (gGsFrame - c->pendSince > 600) { c->pend[0] = 0; }
+        return;
+    }
+    c->pend[0] = 0;
+    f = pack.format & 3;
+    if (sBackend->texSlotsLeft() < pack.levels || (nt = sBackend->texCreate(pack.w, pack.h, f, pack.levels)) == 0) {
+        TexPack_Free(&pack);
+        return;
+    }
+    for (level = 0; level < pack.levels; level++) {
+        uint32_t lw = pack.w >> level ? pack.w >> level : 1, lh = pack.h >> level ? pack.h >> level : 1;
+        void *buf = malloc(pack.bytes[level]);
+        memcpy(buf, pack.data[level], pack.bytes[level]);
+        sBackend->texUpload(nt, level, lw, lh, f, buf, pack.bytes[level]);
+    }
+    sBackend->texDestroy(c->tex);
+    sTexBytes -= c->bytes;
+    c->tex = nt;
+    c->replaced = 1;
+    c->rw = pack.w;
+    c->rh = pack.h;
+    c->amax = c->pendAmax;
+    c->bytes = (uint64_t)pack.w * pack.h * (f == GS_TEXFMT_RGBA8 ? 4u : 1u) * 4u / 3u;
+    sTexBytes += c->bytes;
+    gGpuTexReplaced++;
+    TexPack_Free(&pack);
+}
