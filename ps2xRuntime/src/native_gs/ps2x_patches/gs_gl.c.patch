+/* [ps2x] BT3_PROBE=1: on the BT3_PAGE_TRACE frame, a grid of points (every 32 GS pixels) of the shown buffer's
+   target; every draw that changes one is listed with what it is, and the frame is written to probe_frame.rgba
+   (GS_W x GS_H at 1x, top row first) -- finding the pass behind a wrong pixel */
+#define PROBE_GX 16
+#define PROBE_GY 14
+static void probe_dump(int t, const char *name) { /* a target at 1x, top row first */
+    uint32_t *pic = (uint32_t *)malloc((size_t)GS_W * SCALE * GS_H * SCALE * 4), *one = (uint32_t *)malloc((size_t)GS_W * GS_H * 4);
+    int x, y;
+    FILE *f;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, sTgFbo[t]);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glReadPixels(0, 0, GS_W * SCALE, GS_H * SCALE, GL_RGBA, GL_UNSIGNED_BYTE, pic);
+    for (y = 0; y < GS_H; y++) { for (x = 0; x < GS_W; x++) { one[y * GS_W + x] = pic[(size_t)(y * SCALE) * GS_W * SCALE + x * SCALE]; } }
+    f = fopen(name, "wb");
+    if (f != NULL) { fwrite(one, 4, (size_t)GS_W * GS_H, f); fclose(f); }
+    free(pic); free(one);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+}
