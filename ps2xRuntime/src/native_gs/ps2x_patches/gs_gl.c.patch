+volatile int gNativeGsAniso = 1;
+static void aniso_apply(void) {
+    static int s_cur = 1;
+    static float s_max = 0.0f;
+    int want = gNativeGsAniso, i;
+    if (want == s_cur) return;
+    s_cur = want;
+    if (s_max == 0.0f) {
+        glGetFloatv(0x84FF /* GL_MAX_TEXTURE_MAX_ANISOTROPY */, &s_max);
+        if (s_max < 1.0f) s_max = 1.0f;
+    }
+    for (i = 0; i < 16; i++)
+        if (i & (1 | 8))
+            glSamplerParameterf(sSamplers[i], 0x84FE /* GL_TEXTURE_MAX_ANISOTROPY */,
+                                want < 1 ? 1.0f : ((float)want > s_max ? s_max : (float)want));
+    fprintf(stderr, "bt3: gl: anisotropic filtering %dx (card max %.0fx)\n", want, s_max);
+}
