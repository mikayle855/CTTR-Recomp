+/* [ps2x] the picture being shown, at 512 x 448 (every SCALE-th pixel), to a .ppm (PS2X_NATIVE_GS_PICBURST) */
+void NativeGs_DumpShown(const char *name) {
+    /* (shrunk on the card first: reading the whole picture back at 6x took long enough to make the pacing drop the
+       in-between pictures, which is what was being looked at) */
+    static GLuint fbo, tex;
+    uint8_t *px, *row;
+    FILE *fp;
+    int y, x;
+    if (sShownBest < 0 || sShownBest >= gsTargetCount || !gsTargets[sShownBest].cleared) { return; }
+    if (fbo == 0) {
+        glGenTextures(1, &tex);
+        glBindTexture(GL_TEXTURE_2D, tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 512, 448, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        glGenFramebuffers(1, &fbo);
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, sTgFbo[sShownBest]);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo);
+    glBlitFramebuffer(0, 0, 512 * SCALE, 448 * SCALE, 0, 0, 512, 448, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+    px = malloc(512 * 448 * 4);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, 512, 448, GL_RGBA, GL_UNSIGNED_BYTE, px);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    fp = fopen(name, "wb");
+    if (fp != NULL) {
+        row = malloc(512 * 3);
+        fprintf(fp, "P6\n512 448\n255\n");
+        for (y = 0; y < 448; y++) {
+            for (x = 0; x < 512; x++) { memcpy(&row[x * 3], &px[(y * 512 + x) * 4], 3); }
+            fwrite(row, 1, 512 * 3, fp);
+        }
+        free(row);
+        fclose(fp);
+    }
+    free(px);
+}
